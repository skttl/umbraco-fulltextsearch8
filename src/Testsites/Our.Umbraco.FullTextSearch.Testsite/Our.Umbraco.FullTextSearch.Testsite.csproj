<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="17.0.0-rc2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="17.0.0-rc2" />
    <PackageReference Include="Umbraco.TheStarterKit" Version="17.0.0-rc1" />
    <ProjectReference Include="..\..\Our.Umbraco.FullTextSearch\Our.Umbraco.FullTextSearch.csproj" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="Views\Partials\Components\LatestBlogPosts\Default.cshtml" />
    <_ContentIncludedByDefault Remove="Views\Partials\Components\LatestBlogPosts\NoContent.cshtml" />
    <_ContentIncludedByDefault Remove="Views\Partials\Navigation\SubNavigation.cshtml" />
    <_ContentIncludedByDefault Remove="Views\Partials\Navigation\TopNavigation.cshtml" />
  </ItemGroup>

</Project>
